
{
  "name": "template-string-converter",
  "displayName": "Template String Converter",
  "description": "Automatically converts strings to template literals when typing ${}.",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.146.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onLanguage:javascript",
    "onLanguage:typescript",
    "onLanguage:javascriptreact",
    "onLanguage:typescriptreact",
    "onLanguage:svelte"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "template-string-converter.helloWorld",
        "title": "Hello World"
      }
    ],
    "configuration": {
      "title": "Template String Converter",
      "properties": {
        "template-string-converter.enable": {
          "type": "boolean",
          "default": true,
          "description": "Enable or disable the extension."
        },
        "template-string-converter.validLanguages": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "javascript",
            "typescript",
            "javascriptreact",
            "typescriptreact",
            "svelte"
          ],
          "description": "Languages where the extension should be active."
        },
        "template-string-converter.quoteType": {
          "type": "string",
          "enum": [
            "single",
            "double",
            "both"
          ],
          "default": "both",
          "description": "Choose which quotation marks should be converted."
        },
        "template-string-converter.convertOutermostQuotes": {
          "type": "boolean",
          "default": false,
          "description": "Convert the outermost quotes in nested strings."
        },
        "template-string-converter.autoRemoveTemplateString": {
          "type": "boolean",
          "default": false,
          "description": "Automatically revert template literals when interpolation is removed."
        },
        "template-string-converter.convertWithinTemplateString": {
          "type": "boolean",
          "default": true,
          "description": "Allow conversion inside existing template literals."
        },
        "template-string-converter.addBracketsToProps": {
          "type": "boolean",
          "default": false,
          "description": "Automatically add JSX expression brackets around template literals in properties."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.146.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "typescript-eslint": "^8.61.1",
    "eslint": "^10.5.0",
    "esbuild": "^0.28.1",
    "npm-run-all": "^4.1.5",
    "typescript": "^6.0.3",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
